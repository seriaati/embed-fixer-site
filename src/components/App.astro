---
import Layout from "../layouts/Layout.astro";
import { DEFAULT_LOCALE, getDictionary, localeOptions } from "../i18n";

interface Props {
    lang: string;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const brandName = "Embed Fixer";
const logoPath = "/logo.png";
const inviteUrl = "https://discord.com/oauth2/authorize?client_id=770144963735453696";
const repoUrl = "https://github.com/seriaati/embed-fixer";
const cloneCommand = `git clone ${repoUrl}`;
const platforms = [
    "Twitter/X",
    "Pixiv",
    "TikTok",
    "Reddit",
    "Instagram",
    "FurAffinity",
    "Twitch Clips",
    "Iwara",
    "Bluesky",
    "Kemono",
    "Facebook",
    "Bilibili",
    "Tumblr",
    "Threads",
    "PTT",
    "DeviantArt",
];
const statValues = ["3700+", "210+"];
const settingsCount = String(t.customization.settings.length);
const withCount = (text: string, count: string) => text.replace("{count}", count);
// Split copy so slash commands like /fix and /reset can be set in code type.
const commandParts = (text: string) =>
    text.split(/(\/[a-z-]+)/).map((part) => ({ text: part, code: /^\/[a-z-]+$/.test(part) }));
---

<Layout
    lang={lang}
    title={t.meta.title}
    description={t.meta.description}
    ogImage="/og-image.png"
>
    <header class="hero">
        <div class="wrap">
            <div class="brand">
                <img src={logoPath} alt="" width="28" height="28" />
                <span>{brandName}</span>
            </div>
            <h1
                class="hero-word kinetic"
                id="hero-word"
                aria-label={t.hero.headingLines.join(" ")}
            >
                {
                    t.hero.headingLines.map((line) => (
                        <span class="hero-line" aria-hidden="true">
                            {line}
                        </span>
                    ))
                }
            </h1>
            <div class="hero-base">
                <div>
                    <p class="hero-lede">{t.hero.tagline}</p>
                    <p class="hero-sites">
                        {withCount(t.hero.sitesLead, String(platforms.length))}{" "}
                        <span class="roll" id="roll">{platforms[0]}</span>
                    </p>
                </div>
                <div class="btns">
                    <a class="btn" href={inviteUrl} target="_blank" rel="noreferrer">
                        {t.hero.ctaAdd} <span aria-hidden="true">↗</span>
                    </a>
                    <a class="btn btn--alt" href={repoUrl} target="_blank" rel="noreferrer">
                        {t.hero.ctaGithub} <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="sec" aria-labelledby="problem-heading">
            <div class="wrap">
                <p class="eyebrow">{t.problem.eyebrow}</p>
                <h2 class="h2" id="problem-heading">{t.problem.heading}</h2>
                <div class="breaks">
                    {
                        t.problem.cards.map((card) => (
                            <div class="break">
                                <span class="break-name">{card.name}</span>
                                <p>{card.text}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="sec" aria-labelledby="features-heading">
            <div class="wrap">
                <p class="eyebrow">{t.features.eyebrow}</p>
                <h2 class="h2" id="features-heading">{t.features.heading}</h2>
                <ul class="feats">
                    {
                        t.features.list.map((feature) => (
                            <li class="feat">
                                <h3>{feature.title}</h3>
                                <p>
                                    {commandParts(withCount(feature.text, settingsCount)).map((part) =>
                                        part.code ? <code>{part.text}</code> : part.text,
                                    )}
                                </p>
                                <small>{feature.tag}</small>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <section class="sec" aria-labelledby="platforms-heading">
            <div class="wrap">
                <p class="eyebrow">{t.platforms.eyebrow}</p>
                <h2 class="h2" id="platforms-heading">{t.platforms.heading}</h2>
                <p class="wall" id="wall" role="list" aria-label={t.platforms.ariaLabel}>
                    {
                        platforms.map((name, index) => (
                            <>
                                <span role="listitem">{name}</span>
                                {index < platforms.length - 1 && (
                                    <>
                                        {" "}
                                        <i aria-hidden="true">/</i>{" "}
                                    </>
                                )}
                            </>
                        ))
                    }
                </p>
            </div>
        </section>

        <section class="sec" aria-labelledby="proof-heading">
            <div class="wrap">
                <p class="eyebrow" id="proof-heading">{t.proof.heading}</p>
                <div class="stats" role="list" aria-label={t.proof.ariaLabel}>
                    {
                        statValues.map((value, index) => (
                            <div class="stat" role="listitem">
                                <strong data-count={parseInt(value, 10)}>
                                    {Number.parseInt(value, 10).toLocaleString("en-US")}+
                                </strong>
                                <span>{t.proof.statLabels[index]}</span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="sec" aria-labelledby="customization-heading">
            <div class="wrap">
                <p class="eyebrow">{t.customization.eyebrow}</p>
                <h2 class="h2" id="customization-heading">
                    {t.customization.heading}
                </h2>
                <p class="lead">{t.customization.body}</p>
                <div class="cust-tools">
                    <div class="search">
                        <label for="customization-search" class="visually-hidden">
                            {t.customization.searchLabel}
                        </label>
                        <input
                            id="customization-search"
                            type="search"
                            autocomplete="off"
                            placeholder={withCount(t.customization.searchPlaceholder, settingsCount)}
                        />
                    </div>
                </div>
                <ul
                    class="settings"
                    id="customization-grid"
                    aria-label={t.customization.ariaLabel}
                >
                    {
                        t.customization.settings.map((setting) => (
                            <li class="setting">
                                <h3>{setting.label}</h3>
                                <p>{setting.description}</p>
                            </li>
                        ))
                    }
                </ul>
                <p class="cust-empty" id="customization-empty" hidden>
                    {t.customization.noResults}
                </p>
                <button
                    type="button"
                    id="customization-toggle"
                    class="cust-more"
                    aria-controls="customization-grid"
                    aria-expanded="false"
                    data-label-more={withCount(t.customization.showAll, settingsCount)}
                    data-label-less={t.customization.showFewer}
                    hidden
                >
                    {withCount(t.customization.showAll, settingsCount)}
                </button>
            </div>
        </section>

        <section class="sec" aria-labelledby="hosting-heading">
            <div class="wrap host">
                <div>
                    <p class="eyebrow">{t.hosting.eyebrow}</p>
                    <h2 class="h2" id="hosting-heading">{t.hosting.heading}</h2>
                    <p class="lead">{t.hosting.body}</p>
                </div>
                <div class="host-actions">
                    <div class="cmd">
                        <code id="clone-command">{cloneCommand}</code>
                        <button
                            type="button"
                            id="clone-copy"
                            data-label-copied={t.hosting.copied}
                        >
                            {t.hosting.copy}
                        </button>
                    </div>
                    <a
                        class="btn btn--alt"
                        href={`${repoUrl}#self-hosting`}
                        target="_blank"
                        rel="noreferrer"
                    >
                        {t.hosting.cta} <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </section>

        <section class="close" aria-labelledby="closing-heading">
            <div class="wrap">
                <h2 class="close-word kinetic" id="closing-heading">
                    {t.closing.heading}
                </h2>
                <div class="btns">
                    <a class="btn" href={inviteUrl} target="_blank" rel="noreferrer">
                        {t.hero.ctaAdd} <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </section>

        <footer class="site-footer" aria-label="Site footer">
            <div class="site-footer-row">
                <p id="footer-copyright">{t.footer.copyright}</p>
                <a class="footer-link" href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
                <div
                    class="language-selector"
                    role="group"
                    aria-labelledby="language-label"
                >
                    <label
                        class="language-label"
                        id="language-label"
                        for="language-select-trigger"
                    >
                        {t.languageSelector.label}
                    </label>
                    <button
                        id="language-select-trigger"
                        class="language-select-trigger"
                        type="button"
                        aria-label={t.languageSelector.ariaLabel}
                        aria-haspopup="listbox"
                        aria-expanded="false"
                        aria-controls="language-options"
                    >
                        <span id="language-current-label">
                            {
                                localeOptions.find(
                                    (locale: { code: string; label: string }) =>
                                        locale.code === lang,
                                )?.label
                            }
                        </span>
                        <span class="language-select-caret" aria-hidden="true">
                            <svg
                                viewBox="0 0 16 16"
                                fill="none"
                                aria-hidden="true"
                            >
                                <path
                                    d="M3.5 6.5L8 11L12.5 6.5"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path>
                            </svg>
                        </span>
                    </button>
                    <ul
                        id="language-options"
                        class="language-select-menu"
                        role="listbox"
                        tabindex="-1"
                        hidden
                    >
                        {
                            localeOptions.map(
                                (locale: { code: string; label: string }) => (
                                    <li role="presentation">
                                        <button
                                            type="button"
                                            class="language-option"
                                            role="option"
                                            data-locale={locale.code}
                                            aria-selected={
                                                locale.code === lang
                                                    ? "true"
                                                    : "false"
                                            }
                                        >
                                            {locale.label}
                                        </button>
                                    </li>
                                ),
                            )
                        }
                    </ul>
                </div>
            </div>
        </footer>
    </main>
</Layout>

<script
    is:inline
    define:vars={{
        localeOptions,
        defaultLocale: DEFAULT_LOCALE,
    }}
>
    // --- Locale helpers ---

    const normalizeLocale = (inputLocale) => {
        if (!inputLocale) return defaultLocale;

        const lowered = String(inputLocale).toLowerCase();
        const exact = localeOptions.find(
            (option) => option.code.toLowerCase() === lowered,
        );
        if (exact) return exact.code;

        const base = lowered.split("-")[0];
        const partial = localeOptions.find(
            (option) =>
                option.code.toLowerCase() === base ||
                option.code.toLowerCase().startsWith(`${base}-`),
        );
        return partial?.code ?? defaultLocale;
    };

    const getLocaleHref = (localeCode) => `/${localeCode}/`;

    // --- Dropdown helpers ---

    const byId = (id) => document.getElementById(id);

    const getLanguageElements = () => {
        const trigger = byId("language-select-trigger");
        const menu = byId("language-options");
        const options = Array.from(
            document.querySelectorAll(".language-option"),
        );
        return { trigger, menu, options };
    };

    const closeLanguageMenu = () => {
        const { trigger, menu } = getLanguageElements();
        if (!trigger || !menu) return;
        trigger.setAttribute("aria-expanded", "false");
        menu.hidden = true;
    };

    const openLanguageMenu = () => {
        const { trigger, menu } = getLanguageElements();
        if (!trigger || !menu) return;
        trigger.setAttribute("aria-expanded", "true");
        menu.hidden = false;
    };

    const focusOption = (option) => {
        if (option) option.focus();
    };

    const getSelectedOption = () => {
        const { options } = getLanguageElements();
        return options.find(
            (option) => option.getAttribute("aria-selected") === "true",
        );
    };

    const moveFocus = (direction) => {
        const { options } = getLanguageElements();
        const activeIndex = options.findIndex(
            (option) => option === document.activeElement,
        );
        const selectedIndex = options.indexOf(
            getSelectedOption() ?? options[0],
        );
        const current = activeIndex >= 0 ? activeIndex : selectedIndex;
        focusOption(
            options[(current + direction + options.length) % options.length],
        );
    };

    // --- Navigate on locale choose ---

    const chooseLocale = (localeCode) => {
        window.location.href = getLocaleHref(normalizeLocale(localeCode));
    };

    // --- Wire up events ---

    const initLanguageSelector = () => {
        const { trigger, menu, options } = getLanguageElements();
        if (!trigger || !menu || options.length === 0) return;

        trigger.addEventListener("click", () => {
            const isExpanded = trigger.getAttribute("aria-expanded") === "true";
            if (isExpanded) {
                closeLanguageMenu();
            } else {
                openLanguageMenu();
                focusOption(getSelectedOption() ?? options[0]);
            }
        });

        trigger.addEventListener("keydown", (e) => {
            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                e.preventDefault();
                openLanguageMenu();
                focusOption(
                    e.key === "ArrowDown"
                        ? (getSelectedOption() ?? options[0])
                        : options[options.length - 1],
                );
            }
        });

        options.forEach((option) => {
            option.addEventListener("click", () =>
                chooseLocale(option.dataset.locale),
            );
        });

        menu.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                e.preventDefault();
                closeLanguageMenu();
                trigger.focus();
                return;
            }
            if (e.key === "ArrowDown") {
                e.preventDefault();
                moveFocus(1);
                return;
            }
            if (e.key === "ArrowUp") {
                e.preventDefault();
                moveFocus(-1);
                return;
            }
            if (e.key === "Home") {
                e.preventDefault();
                focusOption(options[0]);
                return;
            }
            if (e.key === "End") {
                e.preventDefault();
                focusOption(options[options.length - 1]);
                return;
            }
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                const active = document.activeElement;
                if (active?.classList?.contains("language-option")) {
                    chooseLocale(active.dataset.locale);
                }
            }
        });

        document.addEventListener("click", (e) => {
            if (!(e.target instanceof Node)) return;
            if (!menu.contains(e.target) && !trigger.contains(e.target)) {
                closeLanguageMenu();
            }
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeLanguageMenu();
        });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLanguageSelector, {
            once: true,
        });
    } else {
        initLanguageSelector();
    }
</script>

<script is:inline>
    // Page interactions. Everything renders complete without JS; this only adds motion and filtering.
    (function () {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const rnd = (a, b) => a + Math.random() * (b - a);

        // --- Kinetic letters ---
        // Broken letters only change transforms, so the layout never reflows while they repair.

        // Space-separated scripts split into words; scripts without spaces (CJK) wrap per character.
        const splitWords = (text) =>
            /\s/.test(text.trim()) ? text.trim().split(/\s+/) : [...text.trim()];

        const makeWord = (word) => {
            const el = document.createElement("span");
            el.className = "k-wd";
            el.setAttribute("aria-hidden", "true");
            [...word].forEach((c) => {
                const ch = document.createElement("span");
                ch.className = "k-ch";
                ch.textContent = c;
                el.appendChild(ch);
            });
            return el;
        };

        // Replace an element's text with word/letter spans; returns the letters.
        const letterize = (el) => {
            const text = el.textContent;
            const spaced = /\s/.test(text.trim());
            const words = splitWords(text).map(makeWord);
            el.textContent = "";
            words.forEach((w, i) => {
                if (i && spaced) el.appendChild(document.createTextNode(" "));
                el.appendChild(w);
            });
            const label = document.createElement("span");
            label.className = "visually-hidden";
            label.textContent = text.trim();
            el.appendChild(label);
            return words.flatMap((w) => [...w.children]);
        };

        const scramble = (c, strength) => {
            c.dataset.ok = "";
            c.style.setProperty("--x", rnd(-0.06, 0.06) * strength + "em");
            c.style.setProperty("--y", rnd(-0.12, 0.12) * strength + "em");
            c.style.setProperty("--r", rnd(-10, 10) * strength + "deg");
            c.style.setProperty("--s", (1 + rnd(-0.28, 0.28) * strength).toFixed(2));
        };

        const repair = (c) => {
            if (c.dataset.ok) return;
            c.dataset.ok = "1";
            c.classList.remove("tofu");
            ["--x", "--y", "--r", "--s"].forEach((p) => c.style.removeProperty(p));
        };

        // Repair letters under the pointer; once the visitor stops, sweep the rest in reading order.
        const makeRepairable = (el, chars) => {
            let idle;
            const sweep = (delay) => {
                clearTimeout(idle);
                idle = setTimeout(function step() {
                    const c = chars.find((c) => !c.dataset.ok);
                    if (!c) return;
                    repair(c);
                    idle = setTimeout(step, 60);
                }, delay);
            };
            el.addEventListener("pointermove", (e) => {
                chars.forEach((c) => {
                    if (c.dataset.ok) return;
                    const r = c.getBoundingClientRect();
                    const d = Math.hypot(e.clientX - (r.left + r.width / 2), e.clientY - (r.top + r.height / 2));
                    if (d < r.height * 0.7) repair(c);
                });
                sweep(3500);
            });
            return sweep;
        };

        // --- Hero headline: lines from the copy on wide screens, one word per line on narrow ones ---

        const hero = document.getElementById("hero-word");
        if (hero) {
            const lines = [...hero.querySelectorAll(".hero-line")].map((l) => {
                const spaced = /\s/.test(l.textContent.trim());
                return { spaced, words: splitWords(l.textContent).map(makeWord) };
            });
            const chars = lines.flatMap((l) => l.words.flatMap((w) => [...w.children]));
            let layout = null;
            let lastWidth = 0;

            const build = (narrow) => {
                hero.textContent = "";
                const groups = narrow
                    ? lines.flatMap((l) => (l.spaced ? l.words.map((w) => ({ spaced: true, words: [w] })) : [l]))
                    : lines;
                groups.forEach((g) => {
                    const line = document.createElement("span");
                    line.className = "hero-line";
                    line.setAttribute("aria-hidden", "true");
                    g.words.forEach((w, i) => {
                        if (i && g.spaced) line.appendChild(document.createTextNode(" "));
                        line.appendChild(w);
                    });
                    hero.appendChild(line);
                });
            };

            // Fill the width, or the height left between the brand and the base row, whichever runs out first.
            let lastHeight = 0;
            const fit = (force) => {
                const width = hero.clientWidth;
                hero.style.fontSize = "1px";
                const height = hero.clientHeight;
                if (width === lastWidth && height === lastHeight && force !== true) {
                    hero.style.fontSize = hero.dataset.fitted;
                    return;
                }
                lastWidth = width;
                lastHeight = height;
                const next = width < 620 ? "narrow" : "wide";
                if (next !== layout) {
                    layout = next;
                    build(layout === "narrow");
                }
                hero.style.fontSize = "100px";
                const widest = Math.max(...[...hero.children].map((l) => l.offsetWidth));
                const byHeight = height / (hero.children.length * 0.8);
                hero.dataset.fitted = Math.max(40, Math.min((100 * width) / widest, byHeight)).toFixed(2) + "px";
                hero.style.fontSize = hero.dataset.fitted;
            };

            fit(true);
            new ResizeObserver(() => fit()).observe(hero);
            addEventListener("resize", () => fit(true));
            document.fonts.ready.then(() => fit(true));

            if (!reduce) {
                const sweep = makeRepairable(hero, chars);
                const breakHero = () => {
                    chars.forEach((c) => {
                        scramble(c, 1);
                        c.classList.toggle("tofu", Math.random() < 0.2);
                    });
                    sweep(4000);
                };
                hero.addEventListener("click", breakHero);
                breakHero();
            }
        }

        // --- Rolling site name ---

        const roll = document.getElementById("roll");
        const sites = [...document.querySelectorAll("#wall [role='listitem']")].map((s) => s.textContent);
        if (roll && sites.length && !reduce) {
            let index = 0;
            let current = document.createElement("span");
            current.textContent = roll.textContent;
            roll.textContent = "";
            roll.appendChild(current);
            setInterval(() => {
                index = (index + 1) % sites.length;
                const next = document.createElement("span");
                next.textContent = sites[index];
                next.className = "next";
                roll.appendChild(next);
                void next.offsetWidth;
                next.className = "";
                current.className = "prev";
                const old = current;
                setTimeout(() => old.remove(), 550);
                current = next;
            }, 1600);
        }

        // --- Problem cards: a missing letter or two, repaired while hovered ---

        document.querySelectorAll(".break-name").forEach((el) => {
            const chars = letterize(el).filter((c) => /\p{L}/u.test(c.textContent));
            const picks = chars.length > 8 ? [0.3, 0.75] : [0.45];
            const broken = [...new Set(picks.map((p) => chars[Math.floor(p * (chars.length - 1))]))];
            const breakIt = () =>
                broken.forEach((c) => {
                    scramble(c, 0.6);
                    c.classList.add("tofu");
                });
            if (reduce) return;
            breakIt();
            const card = el.closest(".break");
            card.addEventListener("pointerenter", () => broken.forEach(repair));
            card.addEventListener("pointerleave", breakIt);
        });

        // --- Supported sites: a slow highlight walks the list ---

        const wall = document.getElementById("wall");
        if (wall && !reduce) {
            const names = [...wall.querySelectorAll("[role='listitem']")];
            let lit = 0;
            let hovering = false;
            names[0].classList.add("lit");
            wall.addEventListener("pointerenter", () => {
                hovering = true;
                names.forEach((n) => n.classList.remove("lit"));
            });
            wall.addEventListener("pointerleave", () => (hovering = false));
            setInterval(() => {
                if (hovering) return;
                names[lit].classList.remove("lit");
                lit = (lit + 1) % names.length;
                names[lit].classList.add("lit");
            }, 900);
        }

        // --- Stats count up once when they scroll into view ---

        if (!reduce) {
            const io = new IntersectionObserver(
                (entries) =>
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        io.unobserve(entry.target);
                        const el = entry.target;
                        const end = Number(el.dataset.count);
                        const t0 = performance.now();
                        (function step(t) {
                            const p = Math.min(1, (t - t0) / 1100);
                            el.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))).toLocaleString("en-US") + "+";
                            if (p < 1) requestAnimationFrame(step);
                        })(t0);
                    }),
                { threshold: 0.6 },
            );
            document.querySelectorAll("[data-count]").forEach((el) => io.observe(el));
        }

        // --- Customization: searchable list, collapsed to a preview ---

        const grid = document.getElementById("customization-grid");
        const search = document.getElementById("customization-search");
        const toggle = document.getElementById("customization-toggle");
        const empty = document.getElementById("customization-empty");
        if (grid && search && toggle && empty) {
            const rows = [...grid.children].map((li) => ({
                li,
                parts: [...li.children].map((el) => ({ el, text: el.textContent })),
            }));
            const escape = (s) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]);
            const highlight = (text, term) => {
                const i = term ? text.toLowerCase().indexOf(term) : -1;
                if (i < 0) return escape(text);
                return escape(text.slice(0, i)) + "<mark>" + escape(text.slice(i, i + term.length)) + "</mark>" + escape(text.slice(i + term.length));
            };
            const render = () => {
                const term = search.value.trim().toLowerCase();
                let shown = 0;
                rows.forEach(({ li, parts }) => {
                    const hit = !term || parts.some((p) => p.text.toLowerCase().includes(term));
                    li.hidden = !hit;
                    if (hit) shown++;
                    parts.forEach((p) => (p.el.innerHTML = highlight(p.text, term)));
                });
                empty.hidden = shown > 0;
                toggle.hidden = !!term;
                grid.classList.toggle("is-collapsed", !term && toggle.getAttribute("aria-expanded") === "false");
            };
            search.addEventListener("input", render);
            toggle.addEventListener("click", () => {
                const open = toggle.getAttribute("aria-expanded") === "true";
                toggle.setAttribute("aria-expanded", String(!open));
                toggle.textContent = open ? toggle.dataset.labelMore : toggle.dataset.labelLess;
                render();
            });
            render();
        }

        // --- Copy the clone command ---

        const copy = document.getElementById("clone-copy");
        const command = document.getElementById("clone-command");
        if (copy && command) {
            const label = copy.textContent.trim();
            copy.addEventListener("click", () => {
                const done = () => {
                    copy.textContent = copy.dataset.labelCopied;
                    setTimeout(() => (copy.textContent = label), 1600);
                };
                navigator.clipboard.writeText(command.textContent).then(done, () => {
                    const range = document.createRange();
                    range.selectNodeContents(command);
                    const sel = getSelection();
                    sel.removeAllRanges();
                    sel.addRange(range);
                });
            });
        }

        // --- Closing line: broken like the hero, repaired by the cursor or after a while on screen ---

        const closing = document.getElementById("closing-heading");
        if (closing && !reduce) {
            // Break about two in five letters; three of those become missing-glyph boxes.
            const chars = letterize(closing);
            chars.forEach((c) => (c.dataset.ok = "1"));
            const letters = chars.filter((c) => /\p{L}/u.test(c.textContent)).sort(() => Math.random() - 0.5);
            letters.slice(0, Math.round(letters.length * 0.4)).forEach((c, i) => {
                scramble(c, 1);
                if (i < 3) c.classList.add("tofu");
            });
            const sweep = makeRepairable(closing, chars);
            new IntersectionObserver(
                (entries, observer) => {
                    if (!entries[0].isIntersecting) return;
                    sweep(5000);
                    observer.disconnect();
                },
                { threshold: 0.6 },
            ).observe(closing);
        }
    })();
</script>
